Resources
| where type =~ "microsoft.hybridcompute/machines"
| extend VMName = name
| extend VMStatus = tostring(properties.status)
| extend MachineFQDN = tostring(properties.osProfile.computerName)
| extend PrivateIP = tostring(properties.networkProfile.networkInterfaces)
| project
    VMName,
    MachineFQDN,
    VMStatus,
    ResourceGroup = resourceGroup,
    Subscription = subscriptionId,
    PrivateIP

- bash: |
    mkdir -p ~/.snowflake

    cat > ~/.snowflake/config.toml <<EOF
    default_connection_name = "ci"

    [connections.ci]
    account = "$(SNOWFLAKE_ACCOUNT)"
    user = "$(SNOWFLAKE_USER)"
    password = "$(SNOWFLAKE_PASSWORD)"
    warehouse = "$(SNOWFLAKE_WAREHOUSE)"
    role = "$(SNOWFLAKE_ROLE)"
    EOF

    chmod 700 ~/.snowflake
    chmod 600 ~/.snowflake/config.toml


    snow sql --connection ci --query "SELECT CURRENT_USER();"

  displayName: Connect to Snowflake

SELECT ARRAY_AGG(
    OBJECT_CONSTRUCT(
        'source_entity', DATABASE_NAME,
        'snowflake_database', DATABASE_NAME,
        'snowflake_schemas', SCHEMAS
    )
) AS DATABASE_SCHEMA_CONFIG
FROM (
    SELECT
        DATABASE_NAME,
        ARRAY_AGG(SCHEMA_NAME)
            WITHIN GROUP (ORDER BY SCHEMA_NAME) AS SCHEMAS
    FROM (
        SELECT DISTINCT
            CATALOG_NAME AS DATABASE_NAME,
            SCHEMA_NAME
        FROM SNOWFLAKE.ACCOUNT_USAGE.SCHEMATA
        WHERE SCHEMA_NAME <> 'INFORMATION_SCHEMA'
    )
    GROUP BY DATABASE_NAME
);

========================================================================
SELECT
    '{' || CHR(10) ||
    '  "source_entity": "' || DATABASE_NAME || '",' || CHR(10) ||
    '  "snowflake_database": "' || DATABASE_NAME || '",' || CHR(10) ||
    '  "snowflake_schemas": [' ||
    LISTAGG('"' || SCHEMA_NAME || '"', ',')
        WITHIN GROUP (ORDER BY SCHEMA_NAME) ||
    ']' || CHR(10) ||
    '}' AS CONFIG
FROM (
    SELECT DISTINCT
        CATALOG_NAME AS DATABASE_NAME,
        SCHEMA_NAME
    FROM SNOWFLAKE.ACCOUNT_USAGE.SCHEMATA
    WHERE SCHEMA_NAME <> 'INFORMATION_SCHEMA'
)
GROUP BY DATABASE_NAME
ORDER BY DATABASE_NAME;


========================================================================
SELECT
    '[' || CHR(10) ||
    REPLACE(
        LISTAGG(
            '  {' || CHR(10) ||
            '    "source_entity": "' || DATABASE_NAME || '",' || CHR(10) ||
            '    "snowflake_database": "' || DATABASE_NAME || '",' || CHR(10) ||
            '    "snowflake_schemas": [' || SCHEMAS || ']' || CHR(10) ||
            '  }',
            '|||'
        ) WITHIN GROUP (ORDER BY DATABASE_NAME),
        '|||',
        ',' || CHR(10)
    ) ||
    CHR(10) || ']' AS DATABASE_SCHEMA_CONFIG
FROM (
    SELECT
        DATABASE_NAME,
        LISTAGG(
            '"' || SCHEMA_NAME || '"',
            ','
        ) WITHIN GROUP (ORDER BY SCHEMA_NAME) AS SCHEMAS
    FROM (
        SELECT DISTINCT
            CATALOG_NAME AS DATABASE_NAME,
            SCHEMA_NAME
        FROM SNOWFLAKE.ACCOUNT_USAGE.SCHEMATA
        WHERE SCHEMA_NAME <> 'INFORMATION_SCHEMA'
          
          -- Exclude deleted schemas
          AND DELETED IS NULL

          -- Exclude databases based on name
          AND NOT REGEXP_LIKE(
              UPPER(CATALOG_NAME),
              'DEV|TEST|SANDBOX|PREPROD|CLONE|UAT|COMMON_UTILITY|CONNECTORS_SECRET|CO_AI_AGENTS|DEMO|DROPPED|EVENTS_DB|RBAC_GEN|STREAMLIT_APPS|USER|UTIL'
          )
    )
    GROUP BY DATABASE_NAME
);

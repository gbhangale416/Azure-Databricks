SELECT
    CASE
        WHEN LAST_LOAD_TIME >= DATEADD(DAY, -1, CURRENT_DATE())
         AND LAST_LOAD_TIME < CURRENT_DATE()
            THEN 'YESTERDAY'
        WHEN LAST_LOAD_TIME >= CURRENT_DATE()
         AND LAST_LOAD_TIME < DATEADD(DAY, 1, CURRENT_DATE())
            THEN 'TODAY'
    END AS LOAD_DATE,

    ROUND(SUM(FILE_SIZE) / POWER(1024, 3), 3) AS LOADED_GB,
    SUM(ROW_COUNT) AS TOTAL_ROWS_LOADED,
    COUNT(*) AS FILE_COUNT

FROM SNOWFLAKE.ACCOUNT_USAGE.COPY_HISTORY

WHERE TABLE_CATALOG_NAME = 'YOUR_DATABASE'
  AND STATUS = 'Loaded'
  AND (
      (LAST_LOAD_TIME >= DATEADD(DAY, -1, CURRENT_DATE())
       AND LAST_LOAD_TIME < CURRENT_DATE())
      OR
      (LAST_LOAD_TIME >= CURRENT_DATE()
       AND LAST_LOAD_TIME < DATEADD(DAY, 1, CURRENT_DATE()))
  )

GROUP BY LOAD_DATE
ORDER BY LOAD_DATE;

To get the file size loaded each day for the last 30 days, including today
WITH DAILY_LOADS AS (
    SELECT
        TO_DATE(LAST_LOAD_TIME) AS LOAD_DATE,
        FILE_SIZE,
        ROW_COUNT
    FROM SNOWFLAKE.ACCOUNT_USAGE.COPY_HISTORY
    WHERE TABLE_CATALOG_NAME = 'YOUR_DATABASE'
      AND TABLE_SCHEMA_NAME = 'YOUR_SCHEMA'
      AND STATUS = 'Loaded'
      AND LAST_LOAD_TIME >= DATEADD(DAY, -29, CURRENT_DATE())
      AND LAST_LOAD_TIME < DATEADD(DAY, 1, CURRENT_DATE())
)
SELECT
    LOAD_DATE,
    ROUND(SUM(FILE_SIZE) / POWER(1024, 3), 3) AS FILE_SIZE_GB,
    COUNT(*) AS FILE_COUNT,
    SUM(ROW_COUNT) AS ROWS_LOADED
FROM DAILY_LOADS
GROUP BY LOAD_DATE
ORDER BY LOAD_DATE DESC;



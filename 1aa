================================================================
r the last 30 days, last 15 days, last 7 days, yesterday, and today


WITH LOAD_DATA AS (
    SELECT
        LAST_LOAD_TIME,
        FILE_SIZE,
        ROW_COUNT
    FROM SNOWFLAKE.ACCOUNT_USAGE.COPY_HISTORY
    WHERE TABLE_CATALOG_NAME = 'YOUR_DATABASE'
      AND TABLE_SCHEMA_NAME = 'YOUR_SCHEMA'
      AND STATUS = 'Loaded'
      AND LAST_LOAD_TIME >= DATEADD(DAY, -30, CURRENT_DATE())
      AND LAST_LOAD_TIME < DATEADD(DAY, 1, CURRENT_DATE())
)
SELECT
    ROUND(SUM(CASE
        WHEN LAST_LOAD_TIME >= DATEADD(DAY, -30, CURRENT_DATE())
         AND LAST_LOAD_TIME < CURRENT_DATE()
        THEN FILE_SIZE ELSE 0
    END) / POWER(1024, 3), 3) AS LAST_30_DAYS_GB,

    ROUND(SUM(CASE
        WHEN LAST_LOAD_TIME >= DATEADD(DAY, -15, CURRENT_DATE())
         AND LAST_LOAD_TIME < CURRENT_DATE()
        THEN FILE_SIZE ELSE 0
    END) / POWER(1024, 3), 3) AS LAST_15_DAYS_GB,

    ROUND(SUM(CASE
        WHEN LAST_LOAD_TIME >= DATEADD(DAY, -7, CURRENT_DATE())
         AND LAST_LOAD_TIME < CURRENT_DATE()
        THEN FILE_SIZE ELSE 0
    END) / POWER(1024, 3), 3) AS LAST_7_DAYS_GB,

    ROUND(SUM(CASE
        WHEN LAST_LOAD_TIME >= DATEADD(DAY, -1, CURRENT_DATE())
         AND LAST_LOAD_TIME < CURRENT_DATE()
        THEN FILE_SIZE ELSE 0
    END) / POWER(1024, 3), 3) AS YESTERDAY_GB,

    ROUND(SUM(CASE
        WHEN LAST_LOAD_TIME >= CURRENT_DATE()
         AND LAST_LOAD_TIME < DATEADD(DAY, 1, CURRENT_DATE())
        THEN FILE_SIZE ELSE 0
    END) / POWER(1024, 3), 3) AS TODAY_GB,

    ROUND(SUM(FILE_SIZE) / POWER(1024, 3), 3) AS TOTAL_TILL_TODAY_GB

FROM LOAD_DATA;


